# Copy to .env.local. Leave NEXT_PUBLIC_ACCOUNTS_ENABLED=false for demo mode (fictional data, no login).
NEXT_PUBLIC_ACCOUNTS_ENABLED=false

# PostgreSQL connection string (Neon → Project → Connect). Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Random secret that signs login sessions. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public address of the app (used in email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Without a key, confirmation/reset links are printed in the server log (development only).
RESEND_API_KEY=
EMAIL_FROM=AcademyOS <no-reply@your-domain.com>

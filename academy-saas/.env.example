# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leaving these empty runs AcademyOS in demo mode (fictional data, no login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public address of the app (used in email links). Example: https://app.academyos.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEVER put the service-role key in a NEXT_PUBLIC_ variable. Server-only, added in Phase 3:
# SUPABASE_SERVICE_ROLE_KEY=
